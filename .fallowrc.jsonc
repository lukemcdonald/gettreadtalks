{
  "$schema": "./fallow.schema.json",
  "ignoreDependencies": [
    // Coss primitives import these; that tree is ignored below.
    "input-otp",
    "react-day-picker",
    // Resend is consumed by the Convex Resend component, not direct app imports.
    "resend",
    // Tailwind is imported from CSS and lives in devDependencies by convention.
    "tailwindcss",
  ],
  "ignorePatterns": [
    // Tool configs are entrypoints for their own CLIs and are already covered by the toolchain.
    "oxfmt.config.ts",
    "oxlint.config.ts",
    // Convex generated files reference generated JS names that do not exist as source files.
    "convex/**/_generated/**",
    // Better Auth CLI output. Do not edit; regenerate with the Better Auth schema command.
    "convex/betterAuth/schema.ts",
    // Coss vendor primitives. Restored by `pnpm update:ui`.
    "src/components/ui/primitives/**",
    // Only imported from ignored Coss primitives.
    "src/hooks/use-media-query.ts",
  ],
}
