# Auth
BETTER_AUTH_BASE_URL=https://localhost:3000
BETTER_AUTH_EMAIL_FROM=noreply@yourdomain.com
BETTER_AUTH_SECRET="your-secret-key-here-change-in-production"
SITE_URL=https://localhost:3000

# Backend & Database
CONVEX_DEPLOYMENT="dev:your-convex-deployment" # For CLI
NEXT_PUBLIC_CONVEX_SITE_URL="https://your-convex-deployment.convex.site"
NEXT_PUBLIC_CONVEX_URL="https://your-convex-deployment.convex.cloud"
# Do not also set CONVEX_SITE_URL here. Convex already injects that for
# functions, and a second site URL name in .env.local blocks `convex dev`
# from updating NEXT_PUBLIC_CONVEX_SITE_URL.
# Vercel Preview only (do not set on Production): Convex Preview Deploy Key as CONVEX_DEPLOY_KEY.
# Convex preview defaults (npx convex env default set --type preview NAME value):
# BETTER_AUTH_SECRET, RESEND_*, SENTRY_DSN, TURNSTILE_SECRET_KEY.
# PREVIEW_USER_EMAIL and PREVIEW_USER_PASSWORD seed a normal (non-admin) login.
# Do not default SITE_URL; Vercel sets it per preview host.

# Email
RESEND_API_KEY=re_dev_api_key
RESEND_TEST_EMAIL=your-email@example.com # For sendTestEmail() function
RESEND_TEST_MODE=true # Set to 'false' to send real emails (defaults to true)
RESEND_WEBHOOK_SECRET=whsec_dev_webhook_secret

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=       # PostHog project API key (from PostHog dashboard)
NEXT_PUBLIC_POSTHOG_HOST=      # https://us.i.posthog.com (or eu.i.posthog.com)

# Monitoring & Observability
NEXT_PUBLIC_SENTRY_DEBUG=false
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_DSN=your-sentry-dsn # Convex-side fallback reporting (see convex/lib/sentry.ts); set as a Convex env var, not read by Next.js

# Security (Cloudflare Turnstile). Site key is public (Next.js).
# Secret is a Convex env var, not read from this file:
# npx convex env set TURNSTILE_SECRET_KEY <secret>
# Local always-pass test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
