{
  "name": "treadtalks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:code": "fallow audit && fallow health --score --hotspots --summary",
    "build": "next build",
    "check": "ultracite check .",
    "clean": "rm -rf node_modules",
    "dev": "npm-run-all --parallel dev:backend dev:frontend dev:open",
    "dev:backend": "convex dev",
    "dev:frontend": "next dev --experimental-https",
    "dev:open": "wait-on https://localhost:3000 && open https://localhost:3000",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "format:fix:yolo": "ultracite fix --unsafe",
    "lint": "oxlint .",
    "lint:fix": "ultracite fix .",
    "release": "convex deploy --yes",
    "release:full": "pnpm build && pnpm release",
    "start": "next start",
    "style": "ultracite fix .",
    "typecheck": "tsc --noEmit",
    "update:ui": "pnpm dlx shadcn@latest add @coss/ui --overwrite",
    "update:ui:styles": "pnpm dlx shadcn@latest add @coss/colors-neutral --overwrite"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.6",
    "@hookform/resolvers": "^5.9.0",
    "@sentry/nextjs": "^10.70.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "convex-helpers": "^0.1.123",
    "input-otp": "^1.4.2",
    "js-sha256": "^0.12.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.417.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "^7.85.0",
    "react-lite-youtube-embed": "^3.6.2",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fallow": "3.18.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.6",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@11.22.0"
}
