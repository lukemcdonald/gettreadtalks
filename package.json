{
  "name": "treadtalks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:code": "fallow audit && fallow health --score --hotspots --summary",
    "build": "next build",
    "build:vercel": "bash scripts/vercel-build.sh",
    "check": "ultracite check .",
    "clean": "rm -rf node_modules",
    "dev": "npm-run-all --parallel dev:backend dev:frontend dev:open",
    "dev:backend": "convex dev",
    "dev:frontend": "next dev --experimental-https",
    "dev:open": "wait-on https://localhost:3000 && open https://localhost:3000",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "format:fix:yolo": "ultracite fix --unsafe",
    "lint": "oxlint .",
    "lint:fix": "ultracite fix .",
    "release": "convex deploy --yes",
    "release:full": "pnpm build && pnpm release",
    "start": "next start",
    "style": "ultracite fix .",
    "typecheck": "tsc --noEmit",
    "update:ui": "pnpm dlx shadcn@latest add @coss/ui --overwrite",
    "update:ui:styles": "pnpm dlx shadcn@latest add @coss/colors-neutral --overwrite"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/rate-limiter": "^0.4.0",
    "@convex-dev/resend": "^0.2.7",
    "@daypicker/react": "^10.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^10.75.2",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "input-otp": "^1.5.0",
    "js-sha256": "^1.0.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.434.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.9.5",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.88.0",
    "react-lite-youtube-embed": "^3.7.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fallow": "3.27.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.0",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@11.22.0"
}
