{
  "name": "treadtalks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check": "biome check .",
    "clean": "rm -rf node_modules",
    "dev": "npm-run-all --parallel dev:backend dev:frontend dev:open",
    "dev:backend": "convex dev",
    "dev:frontend": "next dev --experimental-https",
    "dev:open": "wait-on https://localhost:3000 && open https://localhost:3000",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "format:fix:yolo": "pnpm biome check --write --unsafe .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "release": "convex deploy --yes",
    "release:full": "pnpm build && pnpm release",
    "start": "next start",
    "style": "biome check --write",
    "typecheck": "tsc --noEmit",
    "update:ui": "pnpm dlx shadcn@latest add @coss/ui --overwrite",
    "update:ui:styles": "pnpm dlx shadcn@latest add @coss/colors-neutral --overwrite"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@convex-dev/better-auth": "0.10.10",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.0.4",
    "@sentry/nextjs": "^10.44.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.4.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.33.1",
    "convex-helpers": "^0.1.114",
    "js-sha256": "^0.11.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.362.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.71.2",
    "react-lite-youtube-embed": "^3.5.1",
    "resend": "^6.9.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "knip": "^5.88.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.3.2",
    "wait-on": "^9.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@tailwindcss/oxide",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}
