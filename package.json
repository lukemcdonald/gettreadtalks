{
  "name": "treadtalks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "ultracite check .",
    "clean": "rm -rf node_modules",
    "dev": "npm-run-all --parallel dev:backend dev:frontend dev:open",
    "dev:backend": "convex dev",
    "dev:frontend": "next dev --experimental-https",
    "dev:open": "wait-on https://localhost:3000 && open https://localhost:3000",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "format:fix:yolo": "ultracite fix --unsafe",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "release": "convex deploy --yes",
    "release:full": "pnpm build && pnpm release",
    "start": "next start",
    "style": "ultracite fix .",
    "typecheck": "tsc --noEmit",
    "update:ui": "pnpm dlx shadcn@latest add @coss/ui --overwrite",
    "update:ui:styles": "pnpm dlx shadcn@latest add @coss/colors-neutral --overwrite"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@convex-dev/better-auth": "0.12.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.0.4",
    "@sentry/nextjs": "^10.53.1",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.38.0",
    "convex-helpers": "^0.1.114",
    "input-otp": "^1.4.2",
    "js-sha256": "^0.11.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.373.4",
    "react": "^19.2.6",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.71.2",
    "react-lite-youtube-embed": "^3.5.1",
    "resend": "^6.9.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "knip": "^5.88.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.10.4",
    "wait-on": "^9.0.4"
  },
  "packageManager": "pnpm@11.21.0"
}
