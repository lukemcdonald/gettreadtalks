    "@modelcontextprotocol/server": "^2.3.1",
    "@segment/analytics-next": "^1.84.3",
    "@sentry/nextjs": "^11.8.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.47.0",
    "convex-helpers": "^0.1.128",
    "input-otp": "^1.5.0",
    "js-sha256": "^1.0.0",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
