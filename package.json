{
  "name": "treadtalks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:code": "fallow audit && fallow health --score --hotspots --summary",
    "build": "next build",
    "build:vercel": "bash scripts/vercel-build.sh",
    "check": "ultracite check .",
    "clean": "rm -rf node_modules",
    "dev": "npm-run-all --parallel dev:backend dev:frontend dev:open",
    "dev:backend": "convex dev",
    "dev:frontend": "next dev --experimental-https",
    "dev:open": "wait-on --interval 500 --simultaneous 1 https://localhost:3000 && open https://localhost:3000",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "format:fix:yolo": "ultracite fix --unsafe",
    "lint": "oxlint .",
    "lint:fix": "ultracite fix .",
    "prepare": "skills-npm --agents cursor,claude-code --yes",
    "release": "convex deploy --yes",
    "release:full": "pnpm build && pnpm release",
    "start": "next start",
    "style": "ultracite fix .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "PLAYWRIGHT_SMOKE=1 playwright test --grep @smoke --project chromium --retries=1 --timeout=30000 --workers=2",
    "typecheck": "tsc --noEmit",
    "update:ui": "pnpm dlx shadcn@latest add @coss/ui --overwrite",
    "update:ui:styles": "pnpm dlx shadcn@latest add @coss/colors-neutral --overwrite"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@convex-dev/better-auth": "0.12.5",
